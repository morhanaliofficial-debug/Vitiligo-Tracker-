<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#FFFFFFFF">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vitiligo Tracker" android:textStyle="bold" android:textSize="17sp" android:textColor="#211D2B"/>
    <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Next treatment" android:textSize="15sp" android:textColor="#55505E"/>
    <Button android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open tracker" android:minHeight="40dp"/>
</LinearLayout>
